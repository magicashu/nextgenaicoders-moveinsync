{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moveinsync.example/schemas/evidence-bundle.schema.json",
  "title": "EvidenceBundle",
  "type": "object",
  "required": ["items", "confidence", "coverage", "caveats"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidenceId", "metricId", "source", "contractVersion", "dataVersion"],
        "properties": {
          "evidenceId": { "type": "string" },
          "metricId": { "type": "string" },
          "source": { "type": "string" },
          "contractVersion": { "type": "string" },
          "dataVersion": { "type": "string" }
        }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "coverage": { "type": "integer", "minimum": 0 },
    "caveats": { "type": "array", "items": { "type": "string" } }
  }
}
