{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moveinsync.example/schemas/metric-result.schema.json",
  "title": "MetricResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metricId",
    "metricName",
    "unit",
    "status",
    "supportingCount",
    "periodStart",
    "periodEnd",
    "filters",
    "contractVersion",
    "dataVersion",
    "source",
    "caveats"
  ],
  "properties": {
    "metricId": { "type": "string", "pattern": "^M(0[1-9]|1[0-8])_" },
    "metricName": { "type": "string", "minLength": 1 },
    "unit": {
      "enum": ["PERCENT", "MINUTES", "CURRENCY", "CURRENCY_PER_KM", "PER_1000_TRIPS", "RATING", "COUNT"]
    },
    "status": { "enum": ["SUPPORTED", "UNSUPPORTED"] },
    "value": { "type": ["number", "null"] },
    "baselineValue": { "type": ["number", "null"] },
    "delta": { "type": ["number", "null"] },
    "numerator": { "type": ["number", "null"] },
    "denominator": { "type": ["number", "null"] },
    "supportingCount": { "type": "integer", "minimum": 0 },
    "periodStart": { "type": "string", "format": "date" },
    "periodEnd": { "type": "string", "format": "date" },
    "filters": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "contractVersion": { "const": "metrics-v1.1" },
    "dataVersion": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "caveats": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "SUPPORTED" } } },
      "then": {
        "required": ["value"],
        "properties": { "value": { "type": "number" } }
      }
    }
  ]
}
